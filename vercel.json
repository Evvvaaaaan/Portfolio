{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/oss", "destination": "https://oss-2026-evvvaaaaans-projects.vercel.app" },
    { "source": "/oss/:path*", "destination": "https://oss-2026-evvvaaaaans-projects.vercel.app/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/guestbook", "schedule": "0 4 * * *" }
  ]
}
