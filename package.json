{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spatial": "vite --host 127.0.0.1 --port 5175",
    "spatial:setup": "node spatial/setup.mjs",
    "spatial:setup:completion": "node spatial/setup.mjs --completion",
    "spatial:check": "node spatial/setup.mjs --check",
    "spatial:serve": "node spatial/serve.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^2.0.1",
    "3d-tiles-renderer": "^0.5.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "matter-js": "^0.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.evan.spatialstudio",
    "productName": "Spatial Studio",
    "asar": false,
    "files": ["build/**", "desktop/**", "dev/spatialService.js", "spatial/**", "src/experiments/SpatialStudio/navigation.js", "package.json"],
    "mac": { "target": ["dmg"], "category": "public.app-category.graphics-design" }
  }
}
